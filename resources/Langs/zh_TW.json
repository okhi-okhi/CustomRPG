    "entity": {
        "entity": {
            "print": {
                "name": "%name%:",
                "level": "= |stat.level|: %level%"
            },
            "debugPrint": {
                "id": "= |stat.id|: %id%"
            }
        },
        "ally": {
            "checkLevelUp": "%name% 升到了 %level% 等! 有 %talentPoint% 點天賦點可分配!",
            "print": {
                "exp": "= |stat.exp|: %exp% / %expNext%",
                "hp": "= |stat.hp|: %hp% / %hpMax%",
                "mana": "= |stat.mana|: %mana% / %manaMax%",
                "atk": "= |stat.atk|: %atk% (+%weaponAtk%)",
                "defense": "= |stat.defense|: %defense% (+%armorDefense%)",
                "luck": "= |stat.luck|: %luck%",
                "talent": "= %talent%: %value%",
                "equipments": "= 裝備:",
                "weapon": "- |item.item.name| (%isTwoHand%) 等級: %level%",
                "armor": "- |item.item.name| (%armorType%) 等級: %level%"
            }
        },
        "race": {
            "print": {
                "name": "= |stat.name|: %name%",
                "description": "%description%",
                "strength": "= |stat.strength|: %strength%",
                "vitality": "= |stat.vitality|: %vitality%",
                "dexterity": "= |stat.dexterity|: %dexterity%",
                "intelligence": "= |stat.intelligence|: %intelligence%"
            },
            "debugPrint": {
                "id": "= |stat.id|: %id%",
                "hpMaxBase": "= |stat.hpMaxBase|: %hpMaxBase%",
                "manaMaxBase": "= |stat.manaMaxBase|: %manaMaxBase%",
                "luckBase": "= |stat.luckBase|: %luckBase%"
            }
        },
        "occupation": {
            "print": {
                "name": "= |stat.name|: %name%",
                "description": "%description%",
                "talentPointScale": "= |stat.talentPointScale|: %talentPointScale%"
            },
            "debugPrint": {
                "id": "= |stat.id|: %id%",
                "hpMaxScale": "= |stat.hpMaxScale|: %hpMaxScale%",
                "manaMaxScale": "= |stat.manaMaxScale|: %manaMaxScale%",
                "luckScale": "= |stat.luckScale|: %luckScale%"
            }
        }
    },
    "item": {
        "item": {
            "name": "【%rarity%】%name%",
            "print": {
                "name": "【%rarity%】%name%:"
            },
            "debugPrint": {
                "itemType": "= |stat.itemType|: %itemType%",
                "id": "= |stat.id|: %id%",
                "buyPrice": "= |stat.buyPrice|: %buyPrice%",
                "sellPrice": "= |stat.sellPrice|: %sellPrice%",
                "stackable": "= |stat.stackable|: %stackable%"
            }
        },
        "armor": {
            "armorType": "%armorType% (%armorSlot%)",
            "print": {
                "armorType": "= |stat.armorType|: %armorType%)",
                "level": "= |stat.level|: %level%",
                "atk": "= |stat.atk|: %atk%",
                "defense": "= |stat.defense|: %defense%",
                "durability": "= |stat.durability|: %durability% / %durabilityMax%"
            }
        },
        "weapon": {
            "weaponType": "%weaponType% (%isTwoHand%)",
            "print": {
                "weaponType": "= |stat.weaponType|: %weaponType%",
                "level": "= |stat.level|: %level%",
                "atk": "= |stat.atk|: %atk%",
                "defense": "= |stat.defense|: %defense%",
                "comboRate": "= |stat.comboRate|: %comboRate%",
                "critChance": "= |stat.critChance|: %critChance%",
                "critDamage": "= |stat.critDamage|: %critDamage%",
                "durability": "= |stat.durability|: %durability% / %durabilityMax%"
            }
        },
        "material": {
            "print": {
                "description": "%description%"
            }
        },
        "prop": {
            "print": {
                "description": "%description%"
            }
        }
    },
    "player": {
        "printStats": {
